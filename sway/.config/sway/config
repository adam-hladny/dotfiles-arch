# ---variables---
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term alacritty
set $menu rofi -show drun -show-icons

# ---bg---
output * bg /usr/share/backgrounds/art/joan-miro-the-skiing-lesson.jpg fill

# ---autostart---

exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'WhiteSur-Dark'
    gsettings set org.gnome.desktop.interface icon-theme 'WhiteSur-dark'
    gsettings set org.gnome.desktop.interface cursor-theme 'WhiteSur-cursors'
    gsettings set org.gnome.desktop.interface font-name 'Iosevka Nerd Font 13'
}

exec_always swaync
exec nm-applet --indicator
exec blueman-applet
exec /usr/libexec/polkit-gnome-authentication-agent-1

bar {
     swaybar_command waybar
}

# ---output---
# managed by kanshi, fallbakck:
output eDP-1 {
  resolution 1920x1080
  scale 1.25
  position 0 0
}

# ---input---
input type:touchpad {
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
  dwt disabled
  scroll_factor 0.3
}

input type:keyboard {
  xkb_layout us,sk(qwerty)
  xkb_options grp:lctrl_lwin_toggle
  repeat_delay 250
  repeat_rate 40
}

# ---idle---
exec swayidle -w \
	timeout 900   'gtklock -d' \
	timeout 960   'swaymsg "output * dpms off"' \
	resume        'swaymsg "output * dpms on"' \
	before-sleep  'gtklock -d'

# ---design---
# gaps
gaps inner 8
gaps outer 4

# borders
default_border pixel 1
default_floating_border pixel 1

# window colors			border	bg			text		ind  		child_border
client.focused				#5294e2	#5294e2	#ffffff	#5294e2	#5294e2	
client.focused_inactive	#2d2d2d  #2d2d2d  #a0a0a0  #2d2d2d  #2d2d2d
client.unfocused			#1e1e1e  #1e1e1e  #666666  #1e1e1e  #1e1e1e		
client.urgent				#e06c75  #e06c75  #ffffff  #e06c75  #e06c75

# cursor
seat seat0 xcursor_theme Adwaita 24

# swayfx
corner_radius 10
animation_duration_ms 100
shadows enable

layer_effects "rofi" {
    blur enable;
    shadows enable;
    corner_radius 25;
}

for_window [app_id="gtklock"] blur enable
for_window [app_id="gtklock"] opacity 0.95

# ---key bindings---
# apps
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu

#window
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent
floating_modifier $mod normal

# focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# layout
bindsym $mod+v split toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# resize
mode "resize" {
    bindsym $left  resize shrink width  20px
    bindsym $down  resize grow   height 20px
    bindsym $up    resize shrink height 20px
    bindsym $right resize grow   width  20px
    bindsym Left   resize shrink width  20px
    bindsym Down   resize grow   height 20px
    bindsym Up     resize shrink height 20px
    bindsym Right  resize grow   width  20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# workspaces
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# hw keys
# volume
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+1 waybar
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+1 waybar
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+1 waybar
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# brightness
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+ && pkill -RTMIN+2 waybar
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%- && pkill -RTMIN+2 waybar

# screen 
bindsym $mod+p exec ~/.dotfiles/scripts/cycle_display.sh

# screenshot
bindsym Print exec grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
bindsym $mod+Print exec sh -c 'file="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; grim -g "$(slurp)" "$file" && wl-copy --type image/png < "$file"'

# screen lock
bindsym $mod+Shift+d exec swaylock -f -c 000000

# session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec echo 'Yes, exit' | rofi -dmenu -p 'Exit Sway?' && swaymsg exit

# ---xdg gesktop portal---
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

include /etc/sway/config.d/*
